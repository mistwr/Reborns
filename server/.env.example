# Nunca colocar uma chave real no GitHub nem dentro da APK.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REBORN_ACCESS_TOKEN=
AI_PROVIDER=openai
HOST=127.0.0.1
PORT=8787
# Modelo alternativo executado num computador com Ollama (opcional).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Pesquisa e MCP só são usados quando o botão Ferramentas está ligado na app.
OPENAI_WEB_SEARCH=1
# Conector público de documentação de repositórios. Cada chamada pede decisão na app.
MCP_SERVERS_JSON='[{"label":"deepwiki","url":"https://mcp.deepwiki.com/mcp","allowed_tools":["read_wiki_structure","read_wiki_contents","ask_question"]}]'
# Outros servidores podem usar "token_env":"MCP_GITHUB_TOKEN", definido apenas aqui.
